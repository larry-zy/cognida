# =====================================================================
# Cognida docker-compose 环境变量 —— 复制为 .env 后填入真实值
#   cp .env.docker.example .env
# compose 会自动加载同目录 .env。带 :? 的为必填，缺失则 compose 直接报错。
# 非密项（host/port/开关）已在 compose 内联默认，无需在此重复。
# =====================================================================

# ---------- 必填：基础设施密钥 ----------
# MySQL root 密码（同时用于容器初始化与迁移/服务连接）
DB_PASSWORD=change_me_mysql
# Neo4j 密码
NEO4J_PASSWORD=change_me_neo4j
# JWT 签名密钥：至少 32 字节随机值（openssl rand -hex 32）；不合格则 Go 服务启动即失败
JWT_SECRET=REPLACE_ME_openssl_rand_hex_32

# ---------- 可选：数据库/缓存覆盖 ----------
# DB_USER=root
# DB_NAME=cognida
# Redis 密码（留空=无密码；设置后 go/python 会自动带上）
# REDIS_PASSWORD=
# Milvus 访问 Token（standalone 无鉴权时保持默认即可；云 Milvus 填真实 token）
# MILVUS_TOKEN=root:Milvus

# ---------- 可选：模型 / 外部服务 API Key ----------
# 聊天模型（Go：CHAT_API_KEY）
CHAT_API_KEY=
# Embedding（阿里云 DashScope，Go：EMBEDDING_API_KEY）
EMBEDDING_API_KEY=
# 搜索（Metaso，Go：METASO_API_KEY）
METASO_API_KEY=
# 外部数据源凭证加密密钥（多数据源功能必需，openssl rand -base64 32）
DATASOURCE_SECRET_KEY=
# Python 服务 LLM Key
LLM_API_KEY=

# ---------- 可选：行为开关 ----------
# 前端访问来源（默认 http://localhost:8888；经 nginx 同源时可不改）
# CORS_ALLOWED_ORIGINS=http://localhost:8888
# 开发模式（loopback 免鉴权，生产务必保持 false）
# DEV_MODE=false
# APP_ENV=prod
# LOG_LEVEL=INFO
