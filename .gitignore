# ============================================================
# Cognida monorepo 根级 .gitignore
# 各子服务(cognida-go / cognida-python / cognida-web)另有各自的 .gitignore,
# 此处覆盖跨服务通用的产物、IDE、OS 与工具缓存。
# ============================================================

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db

# ---- 日志 / 运行时 ----
*.log
server.log
frontend.log

# ---- 运行时产物：统一收进仓库根 var/（上传文件 uploads、dev.sh 的 pid/日志 run、
#      agent-eval 产物 test-output 等，本地留存不入库）----
/var/

# ---- 工具产物 ----
.codegraph/
*.db

# ---- Go 产物 ----
services/cognida-go/bin/
services/cognida-go/dist/
services/cognida-go/tmp/
services/cognida-go/server.log

# ---- Python 产物 ----
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
services/cognida-python/data/*.parquet

# ---- Web 产物 ----
apps/cognida-web/node_modules/
apps/cognida-web/dist/
apps/cognida-web/frontend.log

# ---- 环境变量（含变体与备份，避免凭证入库）----
.env
.env.*
!.env.example
!.env.*.example
!.env.sample

# ---- 备份文件 ----
*.bak
*.orig

# ---- Python 大数据集（仅保留代码，不纳入原始数据）----
services/cognida-python/data/

# compiled server binary (build artifact)
/services/cognida-go/server
# compiled milvus-export binary (build artifact of cmd/milvus-export)
/services/cognida-go/milvus-export
# 本地编译的一次性数据播种可执行文件（cmd/seed-eval-datasets 的构建产物）
/services/cognida-go/seed-eval-datasets
# 测评/联调一次性脚手架产物（非源码）
/services/cognida-go/test-output/

# ---- 文档（本地留存，不纳入仓库；含 docs/openspec）----
/docs/

# ---- Claude Code 工具目录（hooks/skills/settings，本地留存，不纳入仓库）----
/.claude/
