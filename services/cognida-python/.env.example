# 应用配置
APP_NAME=cognida-python-tools
APP_ENV=dev
LOG_LEVEL=INFO

# HTTP API 配置（用于调试和管理）
API_HOST=0.0.0.0
API_PORT=8000

# MCP 配置（AI 工具调用）
# 与 dev.sh(py-mcp)/Go 侧 SKILL_ENDPOINT 真源对齐：http 模式 + :3100。
# 用 stdio/:3000 会让 Go 的 data_analysis 工具连不上 → 404，Agent 退回手写 SQL。
MCP_MODE=http               # stdio | http
MCP_PORT=3100               # HTTP 模式下的端口

# gRPC 配置（高性能任务）
GRPC_ENABLED=true
GRPC_PORT=50051
GRPC_MAX_WORKERS=10

# Go 服务配置
GO_SERVICE_URL=http://localhost:8080

# LLM 配置
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4

# 存储配置（可选，Python 服务直接连接）
MILVUS_HOST=localhost
MILVUS_PORT=19530
NEO4J_URI=bolt://localhost:7687

# 文件上传配置（与 Go 共享）
UPLOAD_BASE_DIR=../../var/uploads
ALLOWED_PATHS=../../var/uploads

# 数据库配置（可选）
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Redis 配置（可选）
# REDIS_URL=redis://localhost:6379/0
