# ⚠️ 本文件只放【密钥】类配置（占位示例）。
# 非密配置（端口/host/mode/开关/超时/并发/非密 URL/上传目录/日志级别等）已迁移到
#   config/config.yaml（入库）。请勿把密钥写进 config.yaml。
#
# 加载优先级：Field 默认 < config/config.yaml < 环境变量/.env（覆盖，且是密钥唯一来源）。
# 如需临时覆盖某个非密项，也可在 .env 里设对应环境变量（会覆盖 config.yaml）。
# 实际使用时复制为 .env（.env 已被 gitignore）。

# LLM API 密钥（必填）
LLM_API_KEY=your-api-key-here

# 数据库连接字符串（可选，含账号密码 → 只走环境变量）
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Redis 连接字符串（可选，可能含密码 → 只走环境变量）
# REDIS_URL=redis://localhost:6379/0

# Shared internal HTTP token: set the same value in Go and Python.
# Required for APP_ENV=prod; never use an end-user token. Health endpoints stay public.
INTERNAL_HTTP_AUTH_TOKEN=
# Shared Go/Python gRPC token, also required in production when gRPC is enabled.
GRPC_AUTH_TOKEN=
# Public fetches require HTTPS and public DNS addresses. Explicit private/HTTP exceptions:
URL_ALLOWED_HOSTS=[]

# Lifecycle compute on the evaluation HTTP service (:18888).
LIFECYCLE_TIMEOUT_SECONDS=90
# CLIP: provision a trained model locally; empty means explicit HTTP 503.
IMAGE_MODEL_ID=
IMAGE_MODEL_REVISION=main
# Production should pin a model revision and keep network downloads disabled.
IMAGE_ALLOW_MODEL_DOWNLOAD=false
# Separate image vector space, never the knowledge/text collection.
IMAGE_MILVUS_URI=
IMAGE_MILVUS_TOKEN=
IMAGE_COLLECTION_PREFIX=cognida_image_features
