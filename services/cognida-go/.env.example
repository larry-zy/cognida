# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=cognida

# Neo4j图数据库配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_MAX_POOL_SIZE=50

# JWT配置
# JWT_SECRET 必须替换：至少 32 字节随机密钥（生成示例：openssl rand -hex 32）。
# 占位符 / 缺失 / 长度不足 32 字节时服务启动即失败（fail-closed）。
JWT_SECRET=REPLACE_ME_openssl_rand_hex_32
JWT_ACCESS_TOKEN_EXPIRE=86400
JWT_REFRESH_TOKEN_EXPIRE=604800

# CORS 白名单（逗号分隔，精确匹配 Origin；未配置则不允许任何跨域携带凭证）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 聊天配置
CHAT_SOURCE=remote
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_MODEL_NAME=gpt-3.5-turbo
CHAT_API_KEY=your-openai-api-key-here
CHAT_PROVIDER=openai

# 搜索配置（Metaso API）
METASO_API_KEY=your-metaso-api-key-here
SEARCH_API_ENDPOINT=https://metaso.cn/api/v1/search

# Embedding 配置（阿里云 DashScope）
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_KEY=your-dashscope-api-key-here
EMBEDDING_MODEL=qwen-max
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Milvus配置（可选）
MILVUS_HOST=
MILVUS_TOKEN=

# Redis配置
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
REDIS_MAX_RETRIES=3

# 外部数据源凭证加密密钥（多数据源功能必需）
# 用于 AES-GCM 加密外部数据源密码后落库（密钥经 SHA-256 派生 AES-256 key）。
# 生成方式：openssl rand -base64 32
# 注意：密钥变更后已存凭证不可解密，对应数据源会被标记 need_credentials，需重新录入密码。
DATASOURCE_SECRET_KEY=your-random-secret-generate-with-openssl-rand

# 文件上传配置
UPLOAD_DIR=../../var/uploads

# Python gRPC 服务配置（可选）
PYTHON_GRPC_ENABLED=true
PYTHON_GRPC_TARGET=localhost:50051
PYTHON_GRPC_TIMEOUT=30
# Python 允许访问的文件路径（安全限制）
PYTHON_ALLOWED_PATHS=../../var/uploads

# 评测计分服务地址（独立评测 FastAPI，非 :8000 基础服务）。
# 缺省即 :18888；配错会导致所有评测计分打到基础服务、404 后整任务丢分。
PYTHON_EVALUATION_ENDPOINT=http://localhost:18888
