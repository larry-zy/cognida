# =====================================================================
# Cognida Go 服务 —— 环境变量样例（.env）
#
# 本文件只放【密钥类】变量（密码/Secret/Token/APIKey），以及少数
# 需按机器覆盖的路径/白名单。所有【非密】配置的真源在 config/config.yaml。
#
# 加载优先级：代码默认 < config/config.yaml（非密真源）< 环境变量（覆盖 + 密钥唯一来源）。
# 复制为 .env 并填入真实值；.env 已被 gitignore，绝不入库。
# =====================================================================

# ---------- 密钥（必填/按需） ----------

# 数据库密码（MySQL）
DB_PASSWORD=your_password_here

# Neo4j 密码
NEO4J_PASSWORD=your_neo4j_password_here

# JWT 密钥：至少 32 字节随机值（生成：openssl rand -hex 32）。
# 占位符 / 缺失 / 长度不足 32 字节时服务启动即失败（fail-closed）。
JWT_SECRET=REPLACE_ME_openssl_rand_hex_32

# 聊天模型 API Key
CHAT_API_KEY=your-openai-api-key-here

# 搜索（Metaso）API Key
METASO_API_KEY=your-metaso-api-key-here

# Embedding（阿里云 DashScope）API Key
EMBEDDING_API_KEY=your-dashscope-api-key-here

# Milvus 访问 Token（可选，云服务/鉴权时需要）
MILVUS_TOKEN=

# Redis 密码（可选，本地无密码可留空）
REDIS_PASSWORD=

# 外部数据源凭证加密密钥（多数据源功能必需）
# 用于 AES-GCM 加密外部数据源密码后落库（密钥经 SHA-256 派生 AES-256 key）。
# 生成方式：openssl rand -base64 32
# 注意：密钥变更后已存凭证不可解密，对应数据源会被标记 need_credentials，需重新录入密码。
DATASOURCE_SECRET_KEY=your-random-secret-generate-with-openssl-rand

# ---------- 按机器覆盖（非密；默认真源在 config/config.yaml，如需覆盖再取消注释） ----------

# CORS 白名单（逗号分隔，精确匹配 Origin；未配置则不允许任何跨域携带凭证）。
# 该项直接由中间件从环境变量读取，不在 config.yaml 中。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 文件上传目录（默认 ../../var/uploads，见 config.yaml；按机器可覆盖）
# UPLOAD_DIR=../../var/uploads

# Python 允许访问的文件路径（安全限制，需与上传目录一致）
PYTHON_ALLOWED_PATHS=../../var/uploads

# 如需把 config.yaml 放到非默认位置，可显式指定绝对路径：
# CONFIG_FILE=/abs/path/to/config.yaml
