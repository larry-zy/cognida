# Environment variables
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
server.exe

# Output
/bin/
/dist/
/tmp/
tmp/

# 运行时产物：本地编译的 server 二进制、pid/日志、e2e 评测产物等，本地留存不入库
/var/

# Logs
*.log

# Uploads (keep .gitkeep)
uploads/*
!uploads/.gitkeep

# Node modules (root and web)
node_modules/
web/node_modules/
web/dist/

# Empty/orphan files
nul

# 本地编译的一次性播种可执行文件（cmd/seed/ecommerce 的构建产物）
/ecommerce
